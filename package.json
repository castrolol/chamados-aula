{
  "name": "chamados-aula",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de chamados (help desk) usado na aula de IA como ferramenta de trabalho em TI",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "start": "node server/index.js",
    "build": "vite build",
    "seed": "node server/seed.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.0.0"
  }
}
